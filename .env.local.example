# Copy to .env.local and fill in.
# For local dev, run `npx supabase start` first — it prints these values.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser. Used for admin/document-generation
# server actions that must bypass RLS (e.g. staff bulk exports, doc merge jobs).
SUPABASE_SERVICE_ROLE_KEY=
