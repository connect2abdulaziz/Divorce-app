# Copy to .env.local and fill in.
# Cloud: Project Settings → API → Project URL + anon key
# Local: run `npx supabase start` first — it prints these values.
# AuthRetryableFetchError / "fetch failed" usually means the URL host
# does not resolve (paused/deleted project) or the network is blocked.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser. Used for admin/document-generation
# server actions that must bypass RLS (e.g. staff bulk exports, doc merge jobs).
SUPABASE_SERVICE_ROLE_KEY=
